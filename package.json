{
  "name": "graphql-server-template",
  "version": "1.0.0",
  "repository": "git@github.com:eddeee888/graphql-server-template.git",
  "author": "Eddy Nguyen <ch@eddeee888.me>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start:server": "tsx watch --clear-screen=false src/index.ts",
    "start:codegen": "graphql-codegen --watch",
    "start:test": "tsx --test --watch src/**/*.spec.ts",
    "dev": "run-p -l start:codegen start:server",
    "test": "run-p -l start:codegen start:test",
    "test:once": "tsx --test src/**/*.spec.ts",
    "codegen": "graphql-codegen",
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@graphql-yoga/plugin-defer-stream": "4.1.0",
    "graphql": "17.1.0",
    "graphql-scalars": "2.0.1",
    "graphql-yoga": "6.1.0",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@eddeee888/eslint-plugin": "1.0.1",
    "@eddeee888/gcg-typescript-resolver-files": "0.21.0",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@parcel/watcher": "2.6.0",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "npm-run-all2": "9.1.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.13"
    }
  }
}
