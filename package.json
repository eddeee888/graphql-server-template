{
  "name": "graphql-server-template",
  "version": "1.0.0",
  "repository": "git@github.com:eddeee888/graphql-server-template.git",
  "author": "Eddy Nguyen <ch@eddeee888.me>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start:server": "tsx watch --clear-screen=false src/index.ts",
    "start:codegen": "graphql-codegen --watch",
    "start:test": "tsx --test --watch src/**/*.spec.ts",
    "dev": "run-p -l start:codegen start:server",
    "test": "run-p -l start:codegen start:test",
    "test:once": "tsx --test src/**/*.spec.ts",
    "codegen": "graphql-codegen",
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@graphql-yoga/plugin-defer-stream": "3.21.2",
    "graphql": "17.0.2",
    "graphql-scalars": "1.26.0",
    "graphql-yoga": "5.21.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@eddeee888/eslint-plugin": "1.0.1",
    "@eddeee888/gcg-typescript-resolver-files": "0.18.0",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@parcel/watcher": "2.6.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.7.0"
    }
  }
}
